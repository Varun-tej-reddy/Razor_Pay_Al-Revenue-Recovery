# Razorpay Test Mode Credentials (Get from Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Optional: LLM API Key for LangChain diagnostic agent
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (SQLite default, can switch to PostgreSQL in production)
DATABASE_URL=sqlite:///./recovery_audit.db

# API Authentication Token for FastAPI
API_AUTH_TOKEN=rev_rec_secret_token_2026

# High Value Threshold (in INR)
HIGH_VALUE_THRESHOLD=10000.0

# Server Port
PORT=8000
